# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Full Postgres connection string, e.g. from a local Postgres install,
# or a hosted free-tier database (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgres://user:password@localhost:5432/triplist

PORT=4000

# Optional comma-separated client origins. Leave empty for local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
